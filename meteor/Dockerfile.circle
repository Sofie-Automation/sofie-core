# DEPLOY IMAGE
FROM node:22-alpine

RUN apk add --no-cache tzdata

# The server itself
COPY meteor/package.json /opt/core/meteor/package.json
COPY meteor/dist /opt/core/meteor/dist
COPY meteor/node_modules /opt/core/meteor/node_modules

# The libraries the server links to through its `portal:` dependencies. They are symlinked from
# meteor/node_modules/@sofie-automation/*, so they have to stay siblings of `meteor`, and they resolve
# their own dependencies out of packages/node_modules, so that has to come along too.
COPY packages/node_modules /opt/core/packages/node_modules
COPY packages/blueprints-integration /opt/core/packages/blueprints-integration
COPY packages/corelib /opt/core/packages/corelib
COPY packages/job-worker /opt/core/packages/job-worker
COPY packages/meteor-lib /opt/core/packages/meteor-lib
COPY packages/shared-lib /opt/core/packages/shared-lib

COPY packages/webui/dist /opt/core/webui
COPY meteor/docker-entrypoint.sh /opt

# Where the koa server serves the webui from
ENV SOFIE_WEBUI_DIR=/opt/core/webui

WORKDIR /opt/core/meteor
RUN chown -R 1000:1000 /opt/core
USER 1000
ENTRYPOINT ["/opt/docker-entrypoint.sh"]

# Build context: the repository root, after `yarn build:single packages/live-status-gateway/tsconfig.build.json`
# and `yarn workspaces focus live-status-gateway --production`
FROM node:22-alpine
RUN apk add --no-cache tzdata

ENV NODE_ENV=production

COPY package.json /opt/
COPY node_modules /opt/node_modules
COPY packages/live-status-gateway /opt/packages/live-status-gateway
COPY packages/live-status-gateway-api /opt/packages/live-status-gateway-api
COPY packages/blueprints-integration /opt/packages/blueprints-integration
COPY packages/server-core-integration /opt/packages/server-core-integration
COPY packages/shared-lib /opt/packages/shared-lib
COPY packages/corelib /opt/packages/corelib

WORKDIR /opt/packages/live-status-gateway
RUN chown -R 1000:1000 /opt/packages/live-status-gateway
USER 1000
ENTRYPOINT ["node", "dist/index.js"]

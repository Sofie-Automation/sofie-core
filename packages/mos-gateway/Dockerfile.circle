# Build context: the repository root, after `yarn build:single packages/mos-gateway/tsconfig.build.json`
# and `yarn workspaces focus mos-gateway --production`
FROM node:22-alpine
RUN apk add --no-cache tzdata

ENV NODE_ENV=production

COPY package.json /opt/
COPY node_modules /opt/node_modules
COPY packages/mos-gateway /opt/packages/mos-gateway
COPY packages/server-core-integration /opt/packages/server-core-integration
COPY packages/shared-lib /opt/packages/shared-lib

WORKDIR /opt/packages/mos-gateway
RUN chown -R 1000:1000 /opt/packages/mos-gateway
USER 1000
ENTRYPOINT ["node", "dist/index.js"]

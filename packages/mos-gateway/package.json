{
	"name": "mos-gateway",
	"version": "26.3.0-2",
	"private": true,
	"description": "MOS-Gateway for the Sofie project",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Sofie-Automation/sofie-core.git",
		"directory": "packages/mos-gateway"
	},
	"bugs": {
		"url": "https://github.com/Sofie-Automation/sofie-core/issues"
	},
	"homepage": "https://github.com/Sofie-Automation/sofie-core/blob/main/packages/mos-gateway#readme",
	"author": {
		"name": "Johan Nyman",
		"email": "johan@superfly.tv",
		"url": "http://superfly.tv"
	},
	"contributors": [
		{
			"name": "Jesper Stærkær",
			"email": "jesper@superfly.tv",
			"url": "http://superfly.tv"
		}
	],
	"scripts": {
		"lint": "run -T lint packages/mos-gateway",
		"lint-fix": "run lint --fix",
		"unit": "run -T vitest run --config ../../vitest.config.mts --project mos-gateway",
		"test": "run lint && run unit",
		"test:integration": "run lint && SOFIE_INTEGRATION_TESTS=1 run -T vitest run --config ../../vitest.config.mts --project mos-gateway-integration --coverage=false",
		"watch": "run -T vitest --config ../../vitest.config.mts --project mos-gateway --coverage=false",
		"cov": "run unit; open-cli ../coverage/lcov-report/index.html",
		"cov-open": "open-cli ../coverage/lcov-report/index.html",
		"inspect": "node --inspect dist/index.js",
		"ci": "run test",
		"validate:dependencies": "yarn npm audit --environment production && run license-validate",
		"validate:dev-dependencies": "yarn npm audit --environment development",
		"start": "node dist/index.js",
		"dev": "run start -id localDevMos",
		"license-validate": "run -T sofie-licensecheck"
	},
	"engines": {
		"node": ">=22.20.0"
	},
	"keywords": [
		"mos",
		"broadcast",
		"socket",
		"typescript",
		"javascript",
		"open",
		"source",
		"automation",
		"ncs",
		"nrcs",
		"rundown",
		"production"
	],
	"dependencies": {
		"@mos-connection/connector": "^5.0.0-alpha.0",
		"@sofie-automation/server-core-integration": "26.3.0-2",
		"@sofie-automation/shared-lib": "26.3.0-2",
		"tslib": "^2.8.1",
		"type-fest": "^4.41.0",
		"underscore": "^1.13.8",
		"winston": "^3.19.0"
	},
	"prettier": "@sofie-automation/code-standard-preset/.prettierrc.json",
	"packageManager": "yarn@4.17.0"
}

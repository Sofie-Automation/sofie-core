{
	"extends": "./tsconfig.build.json",
	"exclude": ["node_modules/**"],
	"include": ["src/**/*.ts", "examples/*.ts", "package.json"],
	"compilerOptions": {
		"rootDir": "./",
		"types": ["jest", "node"],
		"skipLibCheck": true, // vitest's types reference DOM types
		"verbatimModuleSyntax": false
	}
}

# Build context: the repository root, after `yarn build`, a webui build and `yarn workspaces focus --production`

# DEPLOY IMAGE
FROM node:22-alpine

RUN apk add --no-cache tzdata

COPY package.json /opt/core/package.json
COPY node_modules /opt/core/node_modules

# The server itself
COPY packages/sofie-core /opt/core/packages/sofie-core
# The workspaces the server depends on. They resolve their dependencies out of /opt/core/node_modules
COPY packages/blueprints-integration /opt/core/packages/blueprints-integration
COPY packages/corelib /opt/core/packages/corelib
COPY packages/job-worker /opt/core/packages/job-worker
COPY packages/meteor-lib /opt/core/packages/meteor-lib
COPY packages/shared-lib /opt/core/packages/shared-lib

COPY packages/webui/dist /opt/core/webui
COPY packages/sofie-core/docker-entrypoint.sh /opt

# Where the koa server serves the webui from
ENV SOFIE_WEBUI_DIR=/opt/core/webui

WORKDIR /opt/core/packages/sofie-core
RUN chown -R 1000:1000 /opt/core
USER 1000
ENTRYPOINT ["/opt/docker-entrypoint.sh"]

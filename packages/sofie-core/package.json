{
	"name": "@sofie-automation/sofie-core",
	"version": "26.3.0-2",
	"private": true,
	"license": "MIT",
	"engines": {
		"node": ">=22.20.0"
	},
	"scripts": {
		"debug": "tsx --watch src/main.ts",
		"start": "node dist/main.js",
		"inject-git-hash": "node ./scripts/generate-version-file.js",
		"lint": "run -T lint packages/sofie-core",
		"unit": "run -T jest",
		"unitci": "run -T jest --maxWorkers 2 --coverage",
		"unitcov": "run -T jest --coverage",
		"test": "run unit",
		"watch": "run -T jest --watch",
		"update-snapshots": "run -T jest --updateSnapshot",
		"cov-open": "run -T open-cli coverage/lcov-report/index.html",
		"cov": "run unitcov && run cov-open",
		"license-validate": "node ../../scripts/checkLicenses.js --allowed=\"MIT,BSD,ISC,Apache,Unlicense,CC0,LGPL,CC BY 3.0,CC BY 4.0,MPL 2.0,Python 2.0\" --excludePackages=timecode,rxjs/ajax,rxjs/fetch,rxjs/internal-compatibility,nw-pre-gyp-module-test,rxjs/operators,rxjs/testing,rxjs/webSocket,undefined,i18next-conv,@fortawesome/fontawesome-common-types,argv,indexof,custom-license,private,public-domain-module,@sofie-automation/corelib,@sofie-automation/shared-lib,@sofie-automation/job-worker",
		"i18n-extract-po": "node ./scripts/extract-i18next-po.mjs",
		"i18n-compile-json": "node ./scripts/i18n-compile-json.mjs",
		"validate:all-dependencies": "run validate:prod-dependencies && run validate:dev-dependencies && run license-validate",
		"validate:prod-dependencies": "yarn npm audit --environment production",
		"validate:dev-dependencies": "yarn npm audit --environment development --severity moderate"
	},
	"dependencies": {
		"@koa/cors": "^5.0.0",
		"@koa/router": "^15.7.0",
		"@mos-connection/helper": "^5.0.0-alpha.0",
		"@slack/webhook": "^7.2.0",
		"@sofie-automation/blueprints-integration": "26.3.0-2",
		"@sofie-automation/corelib": "26.3.0-2",
		"@sofie-automation/job-worker": "26.3.0-2",
		"@sofie-automation/meteor-lib": "26.3.0-2",
		"@sofie-automation/shared-lib": "26.3.0-2",
		"bcrypt": "^6.0.0",
		"deep-extend": "0.6.0",
		"deepmerge": "^4.3.1",
		"ejson": "^2.2.3",
		"elastic-apm-node": "^4.18.0",
		"i18next": "^26.3.6",
		"indexof": "0.0.1",
		"koa": "^3.2.1",
		"koa-bodyparser": "^4.4.1",
		"koa-mount": "^4.2.0",
		"koa-static": "^5.0.0",
		"moment": "^2.30.1",
		"mongodb": "^7.1.1",
		"nanoid": "^3.3.16",
		"ntp-client": "^0.5.3",
		"object-path": "^0.11.8",
		"p-lazy": "^3.1.0",
		"semver": "^7.8.5",
		"superfly-timeline": "9.2.0",
		"threadedclass": "^1.4.0",
		"tslib": "^2.8.1",
		"type-fest": "^4.41.0",
		"underscore": "^1.13.8",
		"winston": "^3.19.0",
		"ws": "^8.21.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@shopify/jest-koa-mocks": "^5.3.1",
		"@sofie-automation/server-core-integration": "26.3.0-2",
		"@types/deep-extend": "^0.6.2",
		"@types/koa": "^3.0.3",
		"@types/koa-bodyparser": "^4.3.13",
		"@types/koa-mount": "^4.0.5",
		"@types/koa-static": "^4.0.4",
		"@types/koa__cors": "^5.0.1",
		"@types/semver": "^7.7.1",
		"@types/ws": "^8.18.1",
		"fast-clone": "^1.5.13",
		"glob": "^13.0.6",
		"i18next-cli": "^1.66.2",
		"i18next-conv": "^16.0.0",
		"jest-util": "^30.4.1",
		"mongodb-memory-server": "^10.1.4",
		"tsx": "^4.23.1"
	},
	"prettier": "@sofie-automation/code-standard-preset/.prettierrc.json"
}

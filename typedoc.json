{
	"name": "Sofie Integration Libraries",
	"out": "docs",
	"theme": "default",
	"readme": "none",
	"entryPoints": ["packages/*"],
	"exclude": [
		"*.spec.ts",
		"node_modules",
		"packages/*/node_modules",
		"docs",
		"packages/*/dist",
		"packages/*/src/types",
		"packages/*/examples",
		"packages/*-gateway",
		"packages/sofie-core",
		"packages/webui",
		"packages/documentation"
	],
	"entryPointStrategy": "packages"
}
